# Copiar a .env local y completar. No contiene claves privadas ni contraseñas.
LOCAL_HOST=127.0.0.1
LOCAL_PORT=4174
LOCAL_ALLOWED_HOSTS=127.0.0.1,localhost
# Para LAN: host 0.0.0.0, hostname estable en la lista y certificado confiable en ambos equipos.
# LOCAL_TLS_CERT=C:/ruta/certificado.pem
# LOCAL_TLS_KEY=C:/ruta/clave-privada.pem
SUPABASE_URL=
SUPABASE_ANON_KEY=
